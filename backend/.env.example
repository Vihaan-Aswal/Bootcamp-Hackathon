# Backend-only configuration. Copy to .env and fill locally; never commit secrets.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_BASE_URL=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
# Set LLM_PROVIDER=fallback to try these OpenRouter models in order, then Groq.
LLM_OPENROUTER_FALLBACK_MODELS=dots-studio/dots-3-note-preview:free,xingchen-agi/xing4.0-29b-a4b:free,apodex/apodex-1.1-mini:free,google/gemma-4-31b-it:free,recursive/flint-v1.0:free
LLM_GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_RESUME_PROCESSING_ALLOWED=false
LLM_JD_PROCESSING_ALLOWED=false
MAX_UPLOAD_MB=10
MAX_PAGES=20
